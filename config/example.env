# ============================================================================
# UPSTREAM API
# ============================================================================
# The history endpoint is configuration, not source: there is deliberately no
# fallback in src/index.js, so the repository does not name the service it calls.
# Set it here for local runs and as a repository secret for GitHub Actions.
# The run fails fast with a clear message if it is unset.
HISTORY_API_URL=https://api.example.com/v1/user/history_all_list

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================
# Comma-separated list of Ethereum/wallet addresses to track
# Example: 0x1234567890123456789012345678901234567890,0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
WALLET_LIST=0x1234567890123456789012345678901234567890

# ============================================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================================
# The spreadsheet ID (can be found in the URL)
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s0t

# Default tab, used when no batch and no --sheet/TARGET_SHEET_NAME is given.
GOOGLE_SHEET_NAME=Sheet1

# ============================================================================
# BATCHING (for 200+ wallets across parallel GitHub Actions matrix jobs)
# ============================================================================
# The wallet list is split into BATCH_TOTAL contiguous slices and each job runs
# one slice, writing to its OWN tab. That tab isolation is what prevents parallel
# runners from clearing and overwriting each other's rows.
#
# Normally set on the command line instead:  node src/index.js --batch 3/10
# BATCH_INDEX=3
# BATCH_TOTAL=10

# Prefix for batch tabs: batch 3 of 10 -> "Batch_03".
BATCH_SHEET_PREFIX=Batch_

# ============================================================================
# CONSOLIDATION  (node src/index.js --consolidate)
# ============================================================================
# The batch tabs are scratch space: they exist only so parallel jobs cannot clear
# and overwrite each other's rows. Left alone they accumulate — one tab per slice,
# one more for every increase to BATCH_TOTAL — so a final job folds them into ONE
# tab and deletes them. The spreadsheet ends each run with a single sheet.
#
# Run it AFTER every batch job (`needs: sync` in the workflow). Deleting a tab a
# job is still writing would lose that job's rows.
#
# The tab everything is merged into; created on first use. Defaults to
# GOOGLE_SHEET_NAME.
MASTER_SHEET_NAME=Transactions

# 1 (default) = delete each "<BATCH_SHEET_PREFIX><digits>" tab once its rows are
# safely in the master tab; 0 keeps them (same as --keep-batches). Deletion only
# ever happens AFTER the master write succeeds, and the name must match that
# pattern exactly — a tab you made by hand is never swept up.
DELETE_BATCH_TABS=1
#
# The master write always MERGES, even when FULL_REFRESH=1 for the batch tabs.
# It has to: the batch tabs are deleted right after, so a wallet whose batch held
# its write back (MIN_SUCCESS_RATIO) exists nowhere else. HISTORY_DAYS still
# prunes rows that aged out, so the tab cannot grow forever.
#
# Rows keep the recorded_at of the run that FETCHED them — consolidation refetches
# nothing, so it must not claim otherwise. Freshness per tab is therefore a batch
# property; in the master, read it per row.

# Force a specific tab, overriding the batch-derived name (same as --sheet).
# TARGET_SHEET_NAME=Batch_03

# Alternative to WALLET_LIST: a JSON file of ["0x..."] or { "wallets": ["0x..."] }.
# WALLETS_FILE=config/wallets.json

# ============================================================================
# HISTORY DEPTH & PAGINATION
# ============================================================================
# The API caps how many rows a single response can return, so asking for 2000 in
# one request silently truncates the history and the newest transactions never
# arrive. The script pages through instead, using the oldest time_at it has seen
# as the `start_time` cursor for the next request.

# Look-back window in DAYS, matched against each transaction's `time_at`.
# Paging stops as soon as the cursor walks past it, so a wallet usually needs
# 1-2 requests instead of 10 — this is the main lever on request volume, and
# therefore on the 403 soft-blocks. Set to 0 to fetch by row count only.
#
# Do NOT disable this to chase full history: 2000 rows is 10 pages, i.e. 11-20
# requests for a SINGLE wallet, which is above the ~10-per-IP quota — one wallet
# would not even finish. Raise HISTORY_DAYS instead and watch the "page(s)" count
# in the log; if wallets start needing 2+ pages, raise BATCH_TOTAL to match.
HISTORY_DAYS=180

# Safety ceiling on rows per wallet (used when a wallet is very busy, or when
# HISTORY_DAYS is 0).
PAGE_COUNT=2000

# Rotate the starting wallet each run (ms per rotation step; 0 disables).
# Without this, a block part-way through a batch starves the same later wallets
# on every run, forever.
ROTATION_PERIOD_MS=3600000

# Rows requested per individual API call.
PAGE_SIZE=200

# Hard cap on pages per wallet — anti-runaway guard, never normally reached.
MAX_PAGES_PER_WALLET=20

# Delay between pages of the SAME wallet, picked at random in this band (ms).
# Smaller than the inter-wallet spacing, but the adaptive delay takes over as
# soon as a 429/403 is seen. (PAGE_DELAY_MS still works as an alias for the min.)
PAGE_DELAY_MIN_MS=1500
PAGE_DELAY_MAX_MS=2000

# Google service account credentials in JSON format
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and paste the entire content here
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============================================================================
# LOGGING
# ============================================================================
# INFO (default) shows a clean, colored summary. DEBUG shows every request,
# retry and cooldown. Set NO_COLOR=1 to disable ANSI colors.
LOG_LEVEL=INFO

# ============================================================================
# GLOBAL SAFETY TIMEOUT GUARD (prevents a GitHub Actions "Canceled")
# ============================================================================
# Stop fetching after this long and flush whatever was collected to Sheets.
# Must stay well below the workflow's `timeout-minutes` (currently 30).
GLOBAL_TIMEOUT_MS=1200000

# Time reserved for the Google Sheets write once fetching stops.
WRITE_RESERVE_MS=90000

# ============================================================================
# RATE LIMIT TUNING (Optional - adaptive defaults are sensible)
# ============================================================================
# Every request waits a RANDOM time in [JITTER_MIN_MS, JITTER_MAX_MS]. The
# randomness matters as much as the length — a fixed cadence is itself a bot
# signal. The floor grows automatically when the API pushes back, and decays
# back down as requests succeed; MAX_DELAY_MS caps that growth.
JITTER_MIN_MS=4000
JITTER_MAX_MS=8000
MAX_DELAY_MS=30000

# ============================================================================
# REQUEST QUOTA  (the single most important setting)
# ============================================================================
# The upstream does NOT rate-limit by time — it blocks at roughly 10 requests
# per IP no matter how slowly they arrive. Two measured runs tripped it at the
# same request number despite a 60% difference in pacing.
#
# Each wallet costs ~2 requests (the API answers the first with a pending job),
# so 8 requests covers ~4 wallets. The run stops cleanly at this budget instead
# of grinding into 403s. Wallets it did not reach are picked up by later runs
# thanks to ROTATION_PERIOD_MS, and MIN_SUCCESS_RATIO keeps a partial run from
# overwriting the tab in the meantime.
#
# Every GitHub Actions matrix job gets a fresh runner and a fresh quota, so the
# way to cover more wallets is MORE, SMALLER batches — not a bigger budget.
MAX_REQUESTS_PER_RUN=8

# ============================================================================
# PROXY (optional)
# ============================================================================
# Route API traffic through a proxy instead of the runner's own IP. PROXY_URL
# wins, then HTTPS_PROXY, then HTTP_PROXY (lower-case variants also work).
# NO_PROXY exempts hosts and supports exact names, ".suffix" and "*".
# PROXY_URL=http://user:pass@proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# --- Pending-job polling ---
# The API replies `{ job: { status: "pending" } }` while it builds the history.
# Polling too fast is what gets the IP soft-blocked, so waits step up:
#   wait = min(PENDING_BASE_MS + (round-1) * PENDING_STEP_MS, PENDING_MAX_MS)
# With the defaults: 20s -> 30s -> 40s -> 50s (ceiling 60s).
PENDING_BASE_MS=20000
PENDING_STEP_MS=10000
PENDING_MAX_MS=60000
MAX_PENDING_ROUNDS=4

# --- 429 / 403 fail-fast ---
# Base cooldown when the API sends NO Retry-After header. A real Retry-After is
# always honored in full; if it exceeds the budget below, the wallet is skipped
# rather than retried early.
RATE_LIMIT_WAIT_MS=60000

# Hard cap on any single cooldown (ms).
MAX_COOLDOWN_MS=120000

# Retries per wallet on 429/403 before giving up on that wallet.
MAX_BLOCK_RETRIES=2

# Total cooldown time a single blocked wallet may consume (ms). Once spent, the
# wallet is skipped so the remaining wallets still get a chance to run.
WALLET_BLOCK_BUDGET_MS=120000

# After this many wallets in a row are blocked, the IP itself is soft-blocked;
# stop fetching entirely and save what we have.
CIRCUIT_BREAKER_THRESHOLD=2

# Maximum attempts per wallet before giving up on it (the run still continues).
MAX_RETRIES=10

# Maximum retries for network timeout errors.
MAX_TIMEOUT_RETRIES=5

# Number of rows to write per Google Sheets update call.
CHUNK_SIZE=500

# Pause between chunk writes (ms). Google allows ~60 write requests/minute/user
# and that quota is shared by every parallel matrix job, so keep this high enough
# for your max-parallel setting.
SHEETS_WRITE_DELAY_MS=1500

# 1 = the tab ends up holding EXACTLY what this run fetched: the merge below is
# skipped entirely, so every recorded_at in the tab comes from the same run and
# "how fresh is this?" is answered by the tab itself.
#
# Pair it with MIN_SUCCESS_RATIO=1. Without the merge, a run that misses a wallet
# would replace a complete snapshot with a thinner one — the data loss the merge
# was introduced to fix. The ratio guard blocks that write instead, leaving the
# previous contents in place for the next run to refresh.
FULL_REFRESH=0

# Writes merge with the rows already in the tab, keyed on a digest of the `raw`
# column (AK) plus `transfer_idx` (AJ), so a partial run only ever ADDS rows:
# wallets it did not reach keep theirs, and rows older than HISTORY_DAYS are
# pruned. Partial results are therefore safe and this defaults to 0. Raise it if
# you would rather hold back results until a whole batch succeeds.
#
# The key is deliberately not the transaction id, nor a set of hand-picked flat
# fields: one hash can legitimately become several rows (both sides of a transfer
# between two tracked wallets, several entries of one `exec`, several tokens in
# one claim), and both earlier attempts at guessing the unique fields lost rows.
#
# wallet_address is in the key because it CANNOT be derived from the payload. On
# a `receive`, other_addr, tx.from_addr and receives[].from_addr are all the
# sender, tx.to_addr is the token contract, and receives[] has no to_addr — the
# wallet that received the money appears nowhere in the response.
MIN_SUCCESS_RATIO=0

# ============================================================================
# ADDRESS-POISONING DETECTION
# ============================================================================
# The upstream reports poisoning dust with is_scam:false, so the scam filter misses it.
# The attack sends a fraction of a cent from an address ground out to share the
# first and last 4 characters of a real counterparty, so the look-alike lands in
# your history and you copy it by mistake next time you pay that counterparty.
#
# Rows are scored and the reason is written to the `suspect` column (AL):
#
#   dust_relayed  worth less than SUSPECT_DUST_USD AND the `receive` did not come
#                 from the account that sent the transaction. A real wallet-to-
#                 wallet transfer has tx_from_addr == recv_from_addr; poisoning is
#                 emitted in bulk by a contract, so the two differ.
#   lookalike     other_addr shares its first 4 and last 4 hex characters with a
#                 DIFFERENT address in the same batch.
#
# Measured on 515 real rows: 70 dust_relayed rows worth $0.0058 in total, the
# largest single one $0.001, with the largest genuine row ($9,396) untouched.
#
# Dust threshold in USD. 0 disables the detection entirely.
SUSPECT_DUST_USD=0.01

# 1 = delete the dust_relayed rows instead of only flagging them.
# Default 0: rows are FLAGGED, never removed, so nothing vanishes from the sheet
# without you asking. `lookalike` is NEVER dropped even at 1 — it flags both
# halves of a pair and cannot tell the impostor from the address it imitates, so
# acting on it would delete the very payment the attacker is targeting.
DROP_SUSPECTED=0

# Optional: override the User-Agent used for API requests.
# HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ... Chrome/120.0.0.0 Safari/537.36
