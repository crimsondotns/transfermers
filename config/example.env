# ============================================================================
# WALLET CONFIGURATION
# ============================================================================
# Comma-separated list of Ethereum/wallet addresses to track
# Example: 0x1234567890123456789012345678901234567890,0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
WALLET_LIST=0x1234567890123456789012345678901234567890

# ============================================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================================
# The spreadsheet ID (can be found in the URL)
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s0t

# Sheet name where data will be written (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Google service account credentials in JSON format
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and paste the entire content here
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============================================================================
# LOGGING
# ============================================================================
# INFO (default) shows a clean, colored summary. DEBUG shows every request,
# retry and cooldown. Set NO_COLOR=1 to disable ANSI colors.
LOG_LEVEL=INFO

# ============================================================================
# GLOBAL SAFETY TIMEOUT GUARD (prevents a GitHub Actions "Canceled")
# ============================================================================
# Stop fetching after this long and flush whatever was collected to Sheets.
# Must stay well below the workflow's `timeout-minutes` (currently 30).
GLOBAL_TIMEOUT_MS=1200000

# Time reserved for the Google Sheets write once fetching stops.
WRITE_RESERVE_MS=90000

# ============================================================================
# RATE LIMIT TUNING (Optional - adaptive defaults are sensible)
# ============================================================================
# Request spacing grows automatically when the API pushes back and decays when
# it recovers. These control the floor / ceiling of that adaptive spacing (ms).
JITTER_MIN_MS=3000
JITTER_MAX_MS=6000
MAX_DELAY_MS=20000

# --- Pending-job polling ---
# The API replies `{ job: { status: "pending" } }` while it builds the history.
# Polling too fast is what gets the IP soft-blocked, so waits step up:
#   wait = min(PENDING_BASE_MS + (round-1) * PENDING_STEP_MS, PENDING_MAX_MS)
# With the defaults: 20s -> 30s -> 40s -> 50s (ceiling 60s).
PENDING_BASE_MS=20000
PENDING_STEP_MS=10000
PENDING_MAX_MS=60000
MAX_PENDING_ROUNDS=4

# --- 429 / 403 fail-fast ---
# Base cooldown when the API sends NO Retry-After header. A real Retry-After is
# always honored in full; if it exceeds the budget below, the wallet is skipped
# rather than retried early.
RATE_LIMIT_WAIT_MS=60000

# Hard cap on any single cooldown (ms).
MAX_COOLDOWN_MS=120000

# Retries per wallet on 429/403 before giving up on that wallet.
MAX_BLOCK_RETRIES=2

# Total cooldown time a single blocked wallet may consume (ms). Once spent, the
# wallet is skipped so the remaining wallets still get a chance to run.
WALLET_BLOCK_BUDGET_MS=120000

# After this many wallets in a row are blocked, the IP itself is soft-blocked;
# stop fetching entirely and save what we have.
CIRCUIT_BREAKER_THRESHOLD=2

# Maximum attempts per wallet before giving up on it (the run still continues).
MAX_RETRIES=10

# Maximum retries for network timeout errors.
MAX_TIMEOUT_RETRIES=5

# Number of rows to write per Google Sheets update call.
CHUNK_SIZE=500

# The sheet is a full-refresh snapshot. If fewer than this share of wallets
# succeed, the destructive clear+write is skipped so a good previous snapshot
# isn't replaced by a mostly-failed one.
MIN_SUCCESS_RATIO=0.5

# Optional: override the User-Agent used for API requests.
# HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ... Chrome/120.0.0.0 Safari/537.36
