# ============================================================================
# WALLET CONFIGURATION
# ============================================================================
# Comma-separated list of Ethereum/wallet addresses to track
# Example: 0x1234567890123456789012345678901234567890,0xabcdefabcdefabcdefabcdefabcdefabcdefabcd
WALLET_LIST=0x1234567890123456789012345678901234567890

# ============================================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================================
# The spreadsheet ID (can be found in the URL)
# https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s0t

# Default tab, used when no batch and no --sheet/TARGET_SHEET_NAME is given.
GOOGLE_SHEET_NAME=Sheet1

# ============================================================================
# BATCHING (for 200+ wallets across parallel GitHub Actions matrix jobs)
# ============================================================================
# The wallet list is split into BATCH_TOTAL contiguous slices and each job runs
# one slice, writing to its OWN tab. That tab isolation is what prevents parallel
# runners from clearing and overwriting each other's rows.
#
# Normally set on the command line instead:  node src/index.js --batch 3/10
# BATCH_INDEX=3
# BATCH_TOTAL=10

# Prefix for batch tabs: batch 3 of 10 -> "Batch_03".
BATCH_SHEET_PREFIX=Batch_

# Force a specific tab, overriding the batch-derived name (same as --sheet).
# TARGET_SHEET_NAME=Batch_03

# Alternative to WALLET_LIST: a JSON file of ["0x..."] or { "wallets": ["0x..."] }.
# WALLETS_FILE=config/wallets.json

# ============================================================================
# HISTORY DEPTH & PAGINATION
# ============================================================================
# The API caps how many rows a single response can return, so asking for 2000 in
# one request silently truncates the history and the newest transactions never
# arrive. The script pages through instead, using the oldest time_at it has seen
# as the `start_time` cursor for the next request.

# Look-back window in DAYS, matched against each transaction's `time_at`.
# Paging stops as soon as the cursor walks past it, so a wallet usually needs
# 1-2 requests instead of 10 — this is the main lever on request volume, and
# therefore on the 403 soft-blocks. Set to 0 to fetch by row count only.
HISTORY_DAYS=90

# Safety ceiling on rows per wallet (used when a wallet is very busy, or when
# HISTORY_DAYS is 0).
PAGE_COUNT=2000

# Rotate the starting wallet each run (ms per rotation step; 0 disables).
# Without this, a block part-way through a batch starves the same later wallets
# on every run, forever.
ROTATION_PERIOD_MS=3600000

# Rows requested per individual API call.
PAGE_SIZE=200

# Hard cap on pages per wallet — anti-runaway guard, never normally reached.
MAX_PAGES_PER_WALLET=20

# Delay between pages of the SAME wallet, picked at random in this band (ms).
# Smaller than the inter-wallet spacing, but the adaptive delay takes over as
# soon as a 429/403 is seen. (PAGE_DELAY_MS still works as an alias for the min.)
PAGE_DELAY_MIN_MS=1500
PAGE_DELAY_MAX_MS=2000

# Google service account credentials in JSON format
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and paste the entire content here
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ============================================================================
# LOGGING
# ============================================================================
# INFO (default) shows a clean, colored summary. DEBUG shows every request,
# retry and cooldown. Set NO_COLOR=1 to disable ANSI colors.
LOG_LEVEL=INFO

# ============================================================================
# GLOBAL SAFETY TIMEOUT GUARD (prevents a GitHub Actions "Canceled")
# ============================================================================
# Stop fetching after this long and flush whatever was collected to Sheets.
# Must stay well below the workflow's `timeout-minutes` (currently 30).
GLOBAL_TIMEOUT_MS=1200000

# Time reserved for the Google Sheets write once fetching stops.
WRITE_RESERVE_MS=90000

# ============================================================================
# RATE LIMIT TUNING (Optional - adaptive defaults are sensible)
# ============================================================================
# Every request waits a RANDOM time in [JITTER_MIN_MS, JITTER_MAX_MS]. The
# randomness matters as much as the length — a fixed cadence is itself a bot
# signal. The floor grows automatically when the API pushes back, and decays
# back down as requests succeed; MAX_DELAY_MS caps that growth.
JITTER_MIN_MS=15000
JITTER_MAX_MS=30000
MAX_DELAY_MS=30000

# ============================================================================
# PROXY (optional)
# ============================================================================
# Route API traffic through a proxy instead of the runner's own IP. PROXY_URL
# wins, then HTTPS_PROXY, then HTTP_PROXY (lower-case variants also work).
# NO_PROXY exempts hosts and supports exact names, ".suffix" and "*".
# PROXY_URL=http://user:pass@proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# --- Pending-job polling ---
# The API replies `{ job: { status: "pending" } }` while it builds the history.
# Polling too fast is what gets the IP soft-blocked, so waits step up:
#   wait = min(PENDING_BASE_MS + (round-1) * PENDING_STEP_MS, PENDING_MAX_MS)
# With the defaults: 20s -> 30s -> 40s -> 50s (ceiling 60s).
PENDING_BASE_MS=20000
PENDING_STEP_MS=10000
PENDING_MAX_MS=60000
MAX_PENDING_ROUNDS=4

# --- 429 / 403 fail-fast ---
# Base cooldown when the API sends NO Retry-After header. A real Retry-After is
# always honored in full; if it exceeds the budget below, the wallet is skipped
# rather than retried early.
RATE_LIMIT_WAIT_MS=60000

# Hard cap on any single cooldown (ms).
MAX_COOLDOWN_MS=120000

# Retries per wallet on 429/403 before giving up on that wallet.
MAX_BLOCK_RETRIES=2

# Total cooldown time a single blocked wallet may consume (ms). Once spent, the
# wallet is skipped so the remaining wallets still get a chance to run.
WALLET_BLOCK_BUDGET_MS=120000

# After this many wallets in a row are blocked, the IP itself is soft-blocked;
# stop fetching entirely and save what we have.
CIRCUIT_BREAKER_THRESHOLD=2

# Maximum attempts per wallet before giving up on it (the run still continues).
MAX_RETRIES=10

# Maximum retries for network timeout errors.
MAX_TIMEOUT_RETRIES=5

# Number of rows to write per Google Sheets update call.
CHUNK_SIZE=500

# Pause between chunk writes (ms). Google allows ~60 write requests/minute/user
# and that quota is shared by every parallel matrix job, so keep this high enough
# for your max-parallel setting.
SHEETS_WRITE_DELAY_MS=1500

# Keep rows belonging to wallets that were NOT refreshed this run, instead of
# clearing them. This is what lets coverage build up across runs even when some
# wallets are soft-blocked. Requires the wallet_address column (added
# automatically to new tabs). Set to 0 for the old destructive full refresh.
MERGE_PRESERVE=1

# Only consulted when MERGE_PRESERVE=0: minimum share of wallets that must
# succeed before a destructive full refresh is allowed.
MIN_SUCCESS_RATIO=0.5

# Optional: override the User-Agent used for API requests.
# HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) ... Chrome/120.0.0.0 Safari/537.36
